spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: ${DB_URL:jdbc:mysql://mysql:3306/picture?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai}
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:root}
  # 图片事件与消费者连接 RabbitMQ（compose 内网服务名 rabbitmq）
  rabbitmq:
    host: ${RABBITMQ_HOST:rabbitmq}
    port: ${RABBITMQ_PORT:5672}
    username: ${RABBITMQ_USERNAME:picture}
    password: ${RABBITMQ_PASSWORD:picture}
  # 全文搜索（SEARCH_ENGINE=es 时使用 compose 内网的 elasticsearch）
  elasticsearch:
    uris: ${ES_URIS:http://elasticsearch:9200}
    username: ${ES_USERNAME:elastic}
    password: ${ES_PASSWORD:picture}
    connection-timeout: 2s
    socket-timeout: 5s
  servlet:
    multipart:
      max-file-size: 2MB
      max-request-size: 3MB
server:
  port: 8123
  # 反向代理（nginx）下由 Tomcat RemoteIpValve 解析转发头，避免伪造 X-Forwarded-For
  forward-headers-strategy: native
  tomcat:
    remoteip:
      # 只信任内网代理地址（Docker 网络），不信任回环地址
      internal-proxies: '10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[0-1])\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}'
  servlet:
    context-path: /api
    session:
      cookie:
        http-only: true
        # 生产环境使用 HTTPS 时设为 true
        secure: ${SESSION_COOKIE_SECURE:false}
        same-site: lax
mybatis-plus:
  configuration:
    map-underscore-to-camel-case: false
    # 生产环境关闭 SQL 日志
    log-impl: org.apache.ibatis.logging.nologging.NoLoggingImpl
  global-config:
    db-config:
      logic-delete-field: isDelete
      logic-delete-value: 1
      logic-not-delete-value: 0
springdoc:
  api-docs:
    enabled: false
  swagger-ui:
    enabled: false
cos:
  client:
    host: ${COS_HOST}
    secretId: ${COS_SECRET_ID}
    secretKey: ${COS_SECRET_KEY}
    region: ${COS_REGION:ap-beijing}
    bucket: ${COS_BUCKET}
app:
  cors:
    allowed-origin-patterns: ${CORS_ALLOWED_ORIGIN_PATTERNS:http://localhost}
  review:
    machine:
      # 默认关闭；开启后按张计费，需 COS 桶已绑定数据万象
      enabled: ${MACHINE_REVIEW_ENABLED:false}
      mode: ${MACHINE_REVIEW_MODE:assist}
  ai:
    # 默认关闭；开启后按 token 计费，使用 DeepSeek 的 OpenAI 兼容接口
    enabled: ${AI_TAG_ENABLED:false}
    base-url: ${DEEPSEEK_BASE_URL:https://api.deepseek.com}
    api-key: ${DEEPSEEK_API_KEY:}
    model: ${AI_MODEL:deepseek-flash}
    daily-limit: ${AI_DAILY_LIMIT:20}
  search:
    # mysql（默认，沿用模糊查询）| es（Elasticsearch 全文检索）
    engine: ${SEARCH_ENGINE:mysql}
management:
  endpoints:
    web:
      exposure:
        include: health,info
  # 需要 metrics 时使用独立管理端口，只在内网/监控网络开放：
  # server:
  #   port: 8124
  endpoint:
    health:
      probes:
        enabled: true
      show-details: never
