<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tzy.picturebackend.mapper.PictureMapper">

    <resultMap id="BaseResultMap" type="com.tzy.picturebackend.model.entity.Picture">
            <id property="id" column="id" />
            <result property="url" column="url" />
            <result property="name" column="name" />
            <result property="introduction" column="introduction" />
            <result property="category" column="category" />
            <result property="tags" column="tags" />
            <result property="picSize" column="picSize" />
            <result property="downloadCount" column="downloadCount" />
            <result property="favoriteCount" column="favoriteCount" />
            <result property="likeCount" column="likeCount" />
            <result property="picWidth" column="picWidth" />
            <result property="picHeight" column="picHeight" />
            <result property="picScale" column="picScale" />
            <result property="picFormat" column="picFormat" />
            <result property="userId" column="userId" />
            <result property="createTime" column="createTime" />
            <result property="editTime" column="editTime" />
            <result property="updateTime" column="updateTime" />
            <result property="isDelete" column="isDelete" />
            <result property="deletedAt" column="deletedAt" />
            <result property="deletedBy" column="deletedBy" />
            <result property="reviewStatus" column="reviewStatus" />
            <result property="reviewMessage" column="reviewMessage" />
            <result property="reviewerId" column="reviewerId" />
            <result property="reviewTime" column="reviewTime" />
            <result property="machineReviewStatus" column="machineReviewStatus" />
            <result property="machineReviewLabel" column="machineReviewLabel" />
            <result property="machineReviewScore" column="machineReviewScore" />
            <result property="machineReviewTime" column="machineReviewTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id,url,name,introduction,category,tags,
        picSize,downloadCount,favoriteCount,likeCount,picWidth,picHeight,picScale,picFormat,
        userId,createTime,editTime,updateTime,isDelete,
        deletedAt,deletedBy,
        reviewStatus,reviewMessage,reviewerId,reviewTime,
        machineReviewStatus,machineReviewLabel,machineReviewScore,machineReviewTime
    </sql>

    <!--
        标签分页查询：先用 (tag, pictureId) 索引从 picture_tag 找出同时包含所有标签的图片，
        再 JOIN picture 取完整数据；普通过滤/排序由 ew.customSqlSegment 提供，避免重复拼接条件。
        多个标签是「同时包含」关系，因此用 GROUP BY + HAVING COUNT(DISTINCT tag) 而不是普通 JOIN。
    -->
    <select id="selectPageByTags" resultMap="BaseResultMap">
        SELECT p.*
        FROM picture p
        JOIN (
            SELECT pt.pictureId
            FROM picture_tag pt
            WHERE pt.tag IN
            <foreach collection="tags" item="tag" open="(" separator="," close=")">
                #{tag}
            </foreach>
            GROUP BY pt.pictureId
            HAVING COUNT(DISTINCT pt.tag) = #{tagCount}
        ) tag_match ON tag_match.pictureId = p.id
        ${ew.customSqlSegment}
    </select>

    <!-- 移入回收站：逻辑删除插件只能更新 isDelete，这里一并写入删除时间与操作人 -->
    <update id="logicalDeleteById">
        UPDATE picture
        SET isDelete  = 1,
            deletedAt = #{deletedAt},
            deletedBy = #{deletedBy}
        WHERE id = #{id}
          AND isDelete = 0
    </update>

    <!-- 批量移入回收站：与单张删除语义一致，只处理仍在正常状态的行 -->
    <update id="logicalDeleteByIds">
        UPDATE picture
        SET isDelete  = 1,
            deletedAt = #{deletedAt},
            deletedBy = #{deletedBy}
        WHERE isDelete = 0
          AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 回收站查询必须绕过逻辑删除插件的 isDelete = 0 过滤 -->
    <select id="selectDeletedById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM picture
        WHERE id = #{id}
          AND isDelete = 1
    </select>

    <update id="restoreById">
        UPDATE picture
        SET isDelete  = 0,
            deletedAt = NULL,
            deletedBy = NULL
        WHERE id = #{id}
          AND isDelete = 1
    </update>

    <!-- 回收站分页：条件由 ew.customSqlSegment 提供，调用方需显式带上 isDelete = 1 -->
    <select id="selectRecyclePage" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM picture
        ${ew.customSqlSegment}
    </select>

    <!--
        到期清理：deletedAt 是首选依据；升级前的历史逻辑删除行没有该字段，用 updateTime 兜底。
        单批限制条数，避免一次清理占用过多数据库连接与 COS 请求。
    -->
    <select id="selectPurgeCandidates" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM picture
        WHERE isDelete = 1
          AND COALESCE(deletedAt, updateTime) &lt; #{before}
        ORDER BY COALESCE(deletedAt, updateTime) ASC, id ASC
        LIMIT #{limit}
    </select>

    <!-- 只有回收站中的记录才允许物理删除，避免误删正常图片 -->
    <delete id="deletePhysicallyByIds">
        DELETE FROM picture
        WHERE isDelete = 1
          AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!--
        互动计数原子增减：column 来自枚举（favoriteCount / likeCount），不是客户端输入。
        delta 为负时用 GREATEST 兜底，并发取消不会把计数减成负数；图片已删除时不更新。
    -->
    <update id="adjustInteractionCount">
        UPDATE picture
        SET ${column} = GREATEST(0, ${column} + #{delta})
        WHERE id = #{id}
          AND isDelete = 0
    </update>

    <!-- 计数重算：按主键游标分批，避免一次性锁住整张 picture 表 -->
    <select id="selectIdsForRecount" resultType="java.lang.Long">
        SELECT id
        FROM picture
        WHERE id &gt; #{afterId}
        ORDER BY id ASC
        LIMIT #{limit}
    </select>

    <!--
        用关系表的真实行数覆盖冗余计数列：
        修复「取消收藏时进程崩溃」「历史数据缺列」等造成的漂移，管理端重算入口调用。
    -->
    <update id="recountInteractions">
        UPDATE picture p
        SET p.favoriteCount = (SELECT COUNT(*)
                               FROM picture_interaction pi
                               WHERE pi.pictureId = p.id
                                 AND pi.type = 'favorite'),
            p.likeCount     = (SELECT COUNT(*)
                               FROM picture_interaction pi
                               WHERE pi.pictureId = p.id
                                 AND pi.type = 'like')
        WHERE p.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
    <!--
        作者主页统计：只统计已过审且未删除的作品，与主页作品列表口径一致。
        SUM 在空集合上返回 NULL，用 COALESCE 兜底为 0，前端不需要处理 null。
    -->
    <select id="selectAuthorStats" resultType="com.tzy.picturebackend.model.vo.AuthorStatsVO">
        SELECT COUNT(*)                          AS pictureCount,
               COALESCE(SUM(downloadCount), 0)   AS downloadCount,
               COALESCE(SUM(favoriteCount), 0)   AS favoriteCount,
               COALESCE(SUM(likeCount), 0)       AS likeCount
        FROM picture
        WHERE userId = #{userId}
          AND isDelete = 0
          AND reviewStatus = 1
    </select>
    <!--
        专辑内图片分页：公开访问只返回已过审图片；作者/管理员可以看全部。
        自定义 SQL 必须显式带上 isDelete = 0。
    -->
    <select id="selectPageByAlbum" resultMap="BaseResultMap">
        SELECT p.*
        FROM picture p
        JOIN album_picture ap ON ap.pictureId = p.id
        WHERE ap.albumId = #{albumId}
          AND p.isDelete = 0
        <if test="onlyPublic">
            AND p.reviewStatus = 1
        </if>
        ORDER BY ap.createTime DESC, ap.pictureId DESC
    </select>

    <resultMap id="NameSuggestionMap" type="com.tzy.picturebackend.model.vo.SearchNameSuggestionVO">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
    </resultMap>

    <resultMap id="HotKeywordMap" type="com.tzy.picturebackend.model.vo.SearchHotKeywordVO">
        <result property="name" column="name"/>
        <result property="count" column="cnt"/>
    </resultMap>

    <!--
        搜索联想只看公开内容：待审核 / 已拒绝 / 回收站里的图片名称不能通过联想被外部探测。
        前缀匹配（不加前导 %）才能命中 idx_name；完全匹配优先、名称更短优先。
    -->
    <select id="selectNameSuggestions" resultMap="NameSuggestionMap">
        SELECT id, name
        FROM picture
        WHERE isDelete = 0
          AND reviewStatus = 1
          AND name IS NOT NULL
          AND name &lt;&gt; ''
          AND name LIKE CONCAT(#{keyword}, '%')
        ORDER BY (name = #{keyword}) DESC, CHAR_LENGTH(name) ASC, id DESC
        LIMIT #{limit}
    </select>

    <select id="selectTagSuggestions" resultType="java.lang.String">
        SELECT DISTINCT pt.tag
        FROM picture_tag pt
                 JOIN picture p ON p.id = pt.pictureId
        WHERE p.isDelete = 0
          AND p.reviewStatus = 1
          AND pt.tag LIKE CONCAT(#{keyword}, '%')
        ORDER BY pt.tag
        LIMIT #{limit}
    </select>

    <select id="selectCategorySuggestions" resultType="java.lang.String">
        SELECT DISTINCT p.category
        FROM picture p
        WHERE p.isDelete = 0
          AND p.reviewStatus = 1
          AND p.category IS NOT NULL
          AND p.category &lt;&gt; ''
          AND p.category LIKE CONCAT(#{keyword}, '%')
        ORDER BY p.category
        LIMIT #{limit}
    </select>

    <!-- 热词按公开图片聚合：标签走 picture_tag，分类直接用 picture.category -->
    <select id="selectHotTags" resultMap="HotKeywordMap">
        SELECT pt.tag AS name, COUNT(*) AS cnt
        FROM picture_tag pt
                 JOIN picture p ON p.id = pt.pictureId
        WHERE p.isDelete = 0
          AND p.reviewStatus = 1
        GROUP BY pt.tag
        ORDER BY cnt DESC, pt.tag ASC
        LIMIT #{limit}
    </select>

    <select id="selectHotCategories" resultMap="HotKeywordMap">
        SELECT p.category AS name, COUNT(*) AS cnt
        FROM picture p
        WHERE p.isDelete = 0
          AND p.reviewStatus = 1
          AND p.category IS NOT NULL
          AND p.category &lt;&gt; ''
        GROUP BY p.category
        ORDER BY cnt DESC, p.category ASC
        LIMIT #{limit}
    </select>
</mapper>
