<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tzy.picturebackend.mapper.AlbumMapper">

    <resultMap id="BaseResultMap" type="com.tzy.picturebackend.model.entity.Album">
        <id property="id" column="id"/>
        <result property="userId" column="userId"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="coverPictureId" column="coverPictureId"/>
        <result property="pictureCount" column="pictureCount"/>
        <result property="isPublic" column="isPublic"/>
        <result property="createTime" column="createTime"/>
        <result property="editTime" column="editTime"/>
        <result property="updateTime" column="updateTime"/>
        <result property="isDelete" column="isDelete"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,userId,name,description,coverPictureId,pictureCount,isPublic,
        createTime,editTime,updateTime,isDelete
    </sql>

    <!-- 原子计数：加图 +n、移图 -n，负数用 GREATEST 兜底 -->
    <update id="incrementPictureCount">
        UPDATE album
        SET pictureCount = GREATEST(0, pictureCount + #{delta})
        WHERE id = #{id}
          AND isDelete = 0
    </update>

    <!-- 计数重算：按主键游标分批，避免一次性锁整张表 -->
    <select id="selectIdsForRecount" resultType="java.lang.Long">
        SELECT id
        FROM album
        WHERE id &gt; #{afterId}
        ORDER BY id ASC
        LIMIT #{limit}
    </select>

    <update id="recountPictureCounts">
        UPDATE album a
        SET a.pictureCount = (SELECT COUNT(*) FROM album_picture ap WHERE ap.albumId = a.id)
        WHERE a.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
