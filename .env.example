# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略
# MySQL root 只用于初始化与备份
DB_ROOT_PASSWORD=root
# 应用专用账号 picture 的密码（对 picture 库有 DDL 权限，Flyway 迁移需要）
DB_PASSWORD=picture

# Redis（生产环境必填，请务必改掉默认值；本地开发用 docker-compose.infra.yml，默认无密码）
REDIS_PASSWORD=root

# RabbitMQ（生产环境必填，请务必改掉默认值；本地开发用 docker-compose.infra.yml，默认 guest/guest）
# 注意：RabbitMQ 的 guest 账号只允许本机登录，容器间连接必须使用自定义账号
RABBITMQ_USERNAME=picture
RABBITMQ_PASSWORD=change-me

# 腾讯云 COS
COS_HOST=https://your-bucket.cos.ap-beijing.myqcloud.com
COS_SECRET_ID=your-secret-id
COS_SECRET_KEY=your-secret-key
COS_REGION=ap-beijing
COS_BUCKET=your-bucket

# 前端访问端口
FRONTEND_PORT=8080

# Grafana（可观测性）：只绑定 127.0.0.1，生产请改掉默认密码
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000

# 链路采样率（0~1）：只影响 trace 上报数量，日志里的 traceId 不受影响
TRACING_SAMPLING_PROBABILITY=0.1

# 后端 JVM 参数（默认堆上限为容器内存 75%，一般不需要改）
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseContainerSupport

# 使用 HTTPS 反代时设为 true，使 Session Cookie 只通过 HTTPS 传输
SESSION_COOKIE_SECURE=false

# 数据万象机审（默认关闭；开启后按张计费，需 COS 桶绑定数据万象并具备审核权限）
MACHINE_REVIEW_ENABLED=false
# assist（只记录结果，默认）| auto-reject（违规自动拒绝）| auto（违规拒绝、正常通过）
MACHINE_REVIEW_MODE=assist

# DeepSeek AI 建议（默认关闭；开启后上传图片会调用 DeepSeek API，按 token 计费）
AI_TAG_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_DAILY_LIMIT=20

# 全文搜索：mysql（默认，沿用模糊查询）| es（Elasticsearch 全文检索）
SEARCH_ENGINE=mysql
# 使用 es 时填写；生产 compose 内网地址为 http://elasticsearch:9200
ES_URIS=http://elasticsearch:9200
ES_USERNAME=elastic
ES_PASSWORD=change-me
